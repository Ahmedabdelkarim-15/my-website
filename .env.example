# ====================================================================
# Market.com - Configuration & API Keys
# ====================================================================

# Server Configuration
PORT=8080
BASE_URL=http://localhost:8080

# Admin Panel Security
ADMIN_JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 1. Supabase Database Configuration
# Get these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# 2. Paymob Payment Gateway (Egypt)
# Get these from: Paymob Dashboard -> Settings -> Account Info / Integrations
PAYMOB_API_KEY=YOUR_PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID_CARD=YOUR_PAYMOB_CARD_INTEGRATION_ID
PAYMOB_INTEGRATION_ID_WALLET=YOUR_PAYMOB_WALLET_INTEGRATION_ID
PAYMOB_IFRAME_ID=YOUR_PAYMOB_IFRAME_ID
PAYMOB_HMAC_SECRET=YOUR_PAYMOB_HMAC_SECRET

# 3. Stripe Payment Gateway
# Get these from: Stripe Dashboard -> Developers -> API Keys / Webhooks
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# 4. Telegram Bot Instant Notifications
# 1) Create a bot via @BotFather on Telegram to get TELEGRAM_BOT_TOKEN
# 2) Get your personal/group Chat ID via @userinfobot to set TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
